# ──────────────────────────────────────────────────────────────
# Amazon SP-API 자격증명 (.env 로 복사한 뒤 값을 채워주세요)
# Seller Central > Apps & Services > Develop Apps 에서 발급
# ──────────────────────────────────────────────────────────────

# 데이터 소스: "mock" (자격증명 없이 샘플 데이터) 또는 "live" (실제 API)
DATA_SOURCE=mock

# LWA (Login with Amazon) 앱 자격증명
SP_API_REFRESH_TOKEN=
SP_API_LWA_APP_ID=
SP_API_LWA_CLIENT_SECRET=

# 마켓플레이스 (RLSW 는 캐나다 amazon.ca / marketplaceID A2EUQ1WTGCTBG2)
SP_API_MARKETPLACE=CA

# ── 광고 데이터(Amazon Ads API)는 별도 인증입니다. 선택 사항 ──
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REFRESH_TOKEN=
ADS_PROFILE_ID=
