# ──────────────────────────────────────────────────────────────
# Streamlit Community Cloud 배포용 Secrets 예시
#
# 이 파일은 "예시"입니다. 실제 값은 레포에 커밋하지 말고,
# Streamlit Cloud 앱 화면의 [Settings] > [Secrets] 에 붙여넣으세요.
# (실제 secrets.toml 은 .gitignore 로 제외되어 있습니다.)
# ──────────────────────────────────────────────────────────────

DATA_SOURCE = "live"
SP_API_MARKETPLACE = "CA"

SP_API_LWA_APP_ID = "amzn1.application-oa2-client.xxxx"
SP_API_LWA_CLIENT_SECRET = "xxxx"
SP_API_REFRESH_TOKEN = "Atzr|xxxx"
